TELEGRAM_BOT_TOKEN=12345:ABCdef...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: comma-separated Telegram numeric user IDs to allowlist
# Leave blank to allow anyone who messages the bot
TELEGRAM_ALLOWED_IDS=

# Optional: system prompt for Claude
CLAUDE_SYSTEM_PROMPT=You are a helpful assistant. Be concise.

# Optional: whisper model size (base / small / medium / large)
WHISPER_MODEL=base

# Optional: how many conversation turns to keep per user
MAX_HISTORY_TURNS=20
